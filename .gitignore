# ==========================================================================
#  构建产物 / 依赖
# ==========================================================================
target/
node_modules/
dist/
out/
*.class

# ==========================================================================
#  本地环境与密钥（deploy/.env 由 deploy/.env.example 复制，不入库）
# ==========================================================================
.env
.env.local
.env.*.local
*.log
logs/

# ==========================================================================
#  IDE：只保留团队共享的工程配置，个人文件一律忽略
#  共享（入库）：.idea/.gitignore、misc.xml、modules.xml、vcs.xml、
#                encodings.xml、compiler.xml、runConfigurations/*.xml
#  个人（忽略）：workspace.xml、tasks.xml、usage.statistics.xml、shelf、
#                jarRepositories.xml、dictionaries、dataSources、httpRequests、
#                以及 IDEA 导入 Maven 时自动生成的 *.iml
# ==========================================================================
.vscode/
.idea/*
!.idea/.gitignore
!.idea/misc.xml
!.idea/modules.xml
!.idea/vcs.xml
!.idea/encodings.xml
!.idea/compiler.xml
!.idea/runConfigurations/
!.idea/runConfigurations/*.xml
!.idea/codeStyles/
!.idea/codeStyles/*.xml

# IDEA 导入 Maven / Gradle 时自动生成的模块文件，不随仓库分发
*.iml

# 即使命中上面的白名单，以下个人文件仍然忽略
.idea/workspace.xml
.idea/tasks.xml
.idea/usage.statistics.xml
.idea/shelf/
.idea/jarRepositories.xml
.idea/dictionaries/
.idea/dataSources.xml
.idea/dataSources.local.xml
.idea/dataSources/
.idea/httpRequests/
.idea/queries/
.idea/inspectionProfiles/
.idea/statistics.xml
.idea/*.iml.bak
**/workspace.xml

# ==========================================================================
#  操作系统 / 工具
# ==========================================================================
.DS_Store
Thumbs.db
desktop.ini
*.swp
