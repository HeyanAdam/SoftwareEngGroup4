# 发件配置示例：复制为 deploy/mail.env 后填写（mail.env 已被 .gitignore 忽略，不会入库）
# 推荐直接用 tools\start-backend.ps1，首次运行会引导你生成这份文件，不用手工复制。

# 可选：brevo / smtp2go / qq
MAIL_PROVIDER=brevo

# Brevo: smtp-relay.brevo.com:587
# SMTP2GO: mail.smtp2go.com:2525
# QQ 邮箱: smtp.qq.com:587
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587

# 发件邮箱（同时也是登录 SMTP 的账号）
MAIL_USERNAME=your@qq.com

# Brevo 填后台生成的 SMTP key；QQ 邮箱填授权码；SMTP2GO 填后台的 SMTP 用户密码
MAIL_PASSWORD=在这里填密码或key

MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true
MAIL_HELO_HOST=brevo.com

# 发件人地址，一般和 MAIL_USERNAME 保持一致；Brevo 必须用后台已验证的那个邮箱
MAIL_FROM=your@qq.com

MAIL_CONNECTION_TIMEOUT=10000
MAIL_READ_TIMEOUT=10000
MAIL_WRITE_TIMEOUT=10000
