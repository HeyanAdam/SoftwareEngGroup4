# ==========================================================================
#  全项目唯一的环境配置文件：复制本文件为 deploy/.env 即可
#    cd deploy
#    Copy-Item .env.example .env        (Windows PowerShell)
#    cp .env.example .env               (macOS / Linux)
#
#  后端启动时会自动读取这份文件（spring.config.import），所以不需要再复制
#  第二份 env。改完这一份，容器和本地进程都生效。
#  只有密钥类需要你手工填（标了「必填」）。.env 已被 .gitignore 忽略。
# ==========================================================================

# ---------- 后端进程（本地 IDE / jar 直接跑） ----------
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
# 数据库由后端启动时的 Flyway 自动迁移，不要手工执行旧 schema.sql

# 后端连本机的中间件（容器内运行时由 compose 注入内网地址，不读这两行）
DB_URL=jdbc:mysql://localhost:3306/kaoyan_ai?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
DB_USERNAME=kaoyan
DB_PASSWORD=kaoyan123

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=root123456
MYSQL_DATABASE=kaoyan_ai
MYSQL_USER=kaoyan
MYSQL_PASSWORD=kaoyan123

# ---------- Redis ----------
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------- RabbitMQ ----------
RABBITMQ_DEFAULT_USER=kaoyan
RABBITMQ_DEFAULT_PASS=kaoyan123
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# ---------- MinIO（原始文件存储） ----------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=kaoyan-files

# ---------- Milvus（向量库） ----------
MILVUS_PORT=19530
MILVUS_COLLECTION=doc_chunk
MILVUS_DIMENSION=1024
VECTOR_TOP_K=6
VECTOR_SCORE_THRESHOLD=0.3

# ---------- Mailpit（本地收信测试） ----------
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025

# ---------- Nginx ----------
NGINX_PORT=8088

# ---------- 对话模型（OpenAI 兼容 API）【必填】 ----------
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-替换成你的Key
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048

# ---------- 向量模型（OpenAI 兼容 API）【必填】 ----------
EMBEDDING_BASE_URL=https://api.deepseek.com/v1
EMBEDDING_API_KEY=sk-替换成你的Key
EMBEDDING_MODEL=bge-m3
# 必须与 MILVUS_DIMENSION 一致；换模型后删掉 Milvus 里的 doc_chunk 让它按新维度重建
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=16

# ---------- 文档切片 ----------
CHUNK_SIZE=400
CHUNK_OVERLAP=80

# 管理员账号不再由配置预置：系统里第一个注册的用户自动成为管理员，
# 之后由管理员在自己后台给其他用户提权。账号数据存在 MySQL 里，重启不丢。
