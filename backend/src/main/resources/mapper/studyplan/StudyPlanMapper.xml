<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.group4.kaoyan.modules.studyplan.mapper.StudyPlanMapper">

    <resultMap id="BaseResultMap" type="com.group4.kaoyan.modules.studyplan.entity.StudyPlan">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="plan_date" property="planDate"/>
        <result column="title" property="title"/>
        <result column="status" property="status"/>
        <result column="version" property="version"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, user_id, plan_date, title, status, version, create_time, update_time
    </sql>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM study_plan WHERE id = #{id}
    </select>

    <select id="selectByUserAndDate" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM study_plan
        WHERE user_id = #{userId} AND plan_date = #{planDate}
    </select>

    <insert id="insert" parameterType="com.group4.kaoyan.modules.studyplan.entity.StudyPlan"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO study_plan (user_id, plan_date, title, status, version, create_time, update_time)
        VALUES (#{userId}, #{planDate}, #{title}, #{status}, #{version}, #{createTime}, #{updateTime})
    </insert>

    <update id="updateWithVersion" parameterType="com.group4.kaoyan.modules.studyplan.entity.StudyPlan">
        UPDATE study_plan
        SET title = #{title},
            status = #{status},
            version = version + 1,
            update_time = #{updateTime}
        WHERE id = #{id}
          AND user_id = #{userId}
          AND version = #{version}
    </update>
</mapper>
