# 复制为 env/.env 后按需修改；docker compose 与后端启动都会读取。
# 中间件账号与 deploy/.env 保持一致，避免两边对不上。
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# MySQL（与 deploy/.env 一致：库 kaoyan_ai，用户 kaoyan）
DB_URL=jdbc:mysql://localhost:3306/kaoyan_ai?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
DB_USERNAME=kaoyan
DB_PASSWORD=kaoyan123

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Milvus
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=doc_chunk
MILVUS_DIMENSION=1024
VECTOR_TOP_K=6
VECTOR_SCORE_THRESHOLD=0.3

# MinIO（原始文件存储）
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=kaoyan-files

# 对话模型（OpenAI 兼容 API）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxxx
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048

# 向量模型（OpenAI 兼容 API）
EMBEDDING_BASE_URL=https://api.deepseek.com/v1
EMBEDDING_API_KEY=sk-xxxx
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=16

# 文档切片
CHUNK_SIZE=400
CHUNK_OVERLAP=80

# 初始管理员
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_PASSWORD=admin123
